// terminal-stuff's tracked default config. This file always exists and is always valid --
// don't edit it to make personal changes (they'd show up in `git diff` and get overwritten by
// pulls); see config/README.md for where personal/machine-specific overrides go instead.
{
  // Paths shown on the hub app's Settings > Paths tab. Extend this list from your own config
  // instead of editing this file -- see config/README.md. ${REPO} and ${HOME} are substituted.
  "paths": [
    { "name": "Repo root", "path": "${REPO}" },
    { "name": "Dotfiles", "path": "${REPO}/dotfiles" },
    { "name": "Setup scripts", "path": "${REPO}/setup" },
    { "name": "Apps", "path": "${REPO}/apps" },
    { "name": "Logs", "path": "${REPO}/logs" },
    { "name": "zshrc", "path": "${HOME}/.zshrc" },
    { "name": "tmux.conf", "path": "${HOME}/.tmux.conf" },
    { "name": "Neovim config", "path": "${HOME}/.config/nvim" },
    { "name": "Hyper config", "path": "${HOME}/.hyper.js" },
    { "name": "SSH config", "path": "${HOME}/.ssh/config" }
  ],

  // tmux2k status bar segments, left and right of the window list. Order here is display order;
  // a segment not listed in either is off. Edit this from the hub app's Status Segments tab, or
  // by hand. Available names are tmux2k's plugins/*.sh files (bandwidth, battery, cpu, cpu-temp,
  // custom, cwd, docker, github, git, gpu, group, keyboard-layout, mise, network, ping, pomodoro,
  // ram, session, storage, tdo, time, updates, uptime, volume, weather).
  "tmux": {
    "statusLeft": ["session", "git", "cwd"],
    "statusRight": ["cpu", "ram", "storage", "volume", "battery", "network", "time"]
  },

  // terminal-stuff's MCP server (apps/mcp-server), wired into pi by the ai-agents setup module.
  // enabledPlugins: which tool collections load (built-in ones in apps/mcp-server/plugins/, private
  // ones in localPluginDir). Edit from the hub app's MCP Server tab; it writes this as {"$replace":
  // [...]} in your own config so a removal really removes. pluginOptions is passed to a plugin as
  // ctx.options, keyed by plugin name.
  //
  // Finer-grained toggles, system-wide default: disabledGroups turns off every tool tagged with any
  // of these groups (a tool can carry more than one, see a plugin's own tools list); disabledTools/
  // enabledTools name individual tools as "<plugin>_<tool>" (disabledTools always wins). presets are
  // named overlays of the same three fields, selected per-session (not edited here) by launching the
  // server with TS_MCP_PRESET=<name> -- see apps/mcp-server/lib/config.mjs for the full resolution
  // order and the raw TS_MCP_DISABLED_GROUPS/_ENABLED_TOOLS/_DISABLED_TOOLS env-var escape hatch.
  "mcp": {
    "enabledPlugins": ["repo"],
    "localPluginDir": "${REPO}/local/mcp-plugins",
    "pluginOptions": {},
    "disabledGroups": [],
    "enabledTools": [],
    "disabledTools": [],
    "presets": {}
  }
}
